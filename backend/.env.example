# =====================================================================
# AI Brain Scanner - Environment Configuration
# =====================================================================

# Model Configuration
# Default: TinyLlama (open, public, no token required, runs on CPU or GPU)
# Alternative: google/gemma-1.1-2b-it (requires HF_TOKEN with accepted Hugging Face license)
MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Execution device: "cpu", "cuda", or "auto"
MODEL_DEVICE=cpu

# Max sequence length for inference and tracing
MAX_SEQUENCE_LENGTH=512

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Optional: Hugging Face Token (only needed for gated models like Gemma)
# HF_TOKEN=hf_your_token_here

# Database
DATABASE_URL=sqlite:///./experiments.db

# Instrumentation Toggles
CAPTURE_ATTENTION=true
CAPTURE_HIDDEN_STATES=true
CAPTURE_MLP_ACTIVATIONS=true
